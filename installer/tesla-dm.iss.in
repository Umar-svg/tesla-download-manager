; Inno Setup script for Tesla Download Manager.
; Generated by CMake from installer/tesla-dm.iss.in. Do not edit the copy in the build tree.
;
; Input: the CMake install tree, created with
;   cmake --install build/msvc-release --prefix build/msvc-release/stage
; Build: ISCC.exe build/msvc-release/tesla-dm.iss

#define AppName "Tesla Download Manager"
#define AppVersion "@PROJECT_VERSION@"
#define StageDir "@CMAKE_BINARY_DIR@/stage"
#define AppExe "TeslaDM.exe"

[Setup]
AppId={{AA22D599-4545-4205-94DF-3ADCBF6582FE}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
; Per-user install: no administrator rights needed.
PrivilegesRequired=lowest
DefaultDirName={localappdata}\Programs\TeslaDM
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
OutputDir=@CMAKE_BINARY_DIR@/installer
OutputBaseFilename=TeslaDM-{#AppVersion}-setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\bin\{#AppExe}
UninstallDisplayName={#AppName}
; Close a running Tesla DM (Restart Manager) before replacing its files.
CloseApplications=yes
RestartApplications=no

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\bin\{#AppExe}"
Name: "{group}\Third-party notices"; Filename: "{app}\THIRD_PARTY_NOTICES.txt"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\bin\{#AppExe}"; Tasks: desktopicon

[Run]
Filename: "{app}\bin\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[Code]
// Uninstall removes the program files. The download list, settings and any
// unfinished .tdmpart bookkeeping in %LOCALAPPDATA%\TeslaDM are removed only
// if the user agrees; silent uninstalls keep them. Downloaded files in the
// user's own folders are never touched.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    if (not UninstallSilent) and
       (MsgBox('Also delete your download list and settings?' #13#10#13#10 +
               'Files you downloaded are not affected.', mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES) then
    begin
      DelTree(ExpandConstant('{localappdata}\TeslaDM'), True, True, True);
      RegDeleteKeyIncludingSubkeys(HKCU, 'Software\TeslaDM');
    end;
  end;
end;
